{
  "name": "iitm-slotbook-preference-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Vercel portal for collecting IITM student and instructor slot preferences.",
  "scripts": {
    "check": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "sync-catalog": "node scripts/sync-catalog.mjs",
    "serve": "python3 -m http.server 4173 --directory public",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "dev": "node scripts/dev-server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14"
  }
}
