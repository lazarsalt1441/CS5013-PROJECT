# Postgres connection string. On Neon use the *pooled* connection string
# (host contains "-pooler") from Dashboard -> Connect, with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-REPLACE-ME-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Password typed only into the admin page. Use a long random value in Vercel.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional HTTP endpoint wrapping the Java solver.
# It receives JSON containing student_preferences_csv,
# instructor_preferences_csv, prerequisites_csv and completed_courses_csv,
# and should return assignment/explanation rows.
SOLVER_API_URL=
SOLVER_API_KEY=
