# Deployed Google Apps Script /exec URL.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Password typed only into the admin page. Use a long random value in Vercel.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Same secret stored as ADMIN_API_KEY in Apps Script properties.
GOOGLE_APPS_SCRIPT_ADMIN_KEY=replace-with-another-long-random-key

# Optional HTTP endpoint wrapping the Java solver.
# It receives JSON containing student_preferences_csv and
# instructor_preferences_csv and should return assignment/explanation rows.
SOLVER_API_URL=
SOLVER_API_KEY=
